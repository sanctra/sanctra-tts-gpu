FROM nvidia/cuda:12.1.0-runtime-ubuntu22.04

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    git ffmpeg python3 python3-pip python3-dev build-essential ca-certificates wget libsndfile1 && \
    rm -rf /var/lib/apt/lists/*

# Torch for CUDA 12.1
RUN pip3 install --no-cache-dir --upgrade pip && \
    pip3 install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121

# Service deps
RUN pip3 install --no-cache-dir fastapi uvicorn[standard] pydantic[dotenv] \
    websockets httpx numpy soundfile scipy "coqpit>=0.0.17" \
    TTS==0.22.0

WORKDIR /srv
COPY server ./server
COPY start.sh ./start.sh
RUN chmod +x ./start.sh

EXPOSE 9200
CMD ["./start.sh"]
